<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-radius: 2em; -fx-background-color: #77ccd4;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.todolist.loginController">
   <children>
      <Label alignment="CENTER" layoutX="50.0" layoutY="56.0" prefHeight="50.0" prefWidth="506.0" text="welcome back ">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
      <Label layoutX="50.0" layoutY="130.0" text="username:">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <TextField fx:id="username" layoutX="50.0" layoutY="174.0" prefHeight="39.0" prefWidth="506.0" promptText="username" style="-fx-background-radius: 2em;">
         <font>
            <Font size="20.0" />
         </font>
      </TextField>
      <Label layoutX="51.0" layoutY="229.0" text="password:">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <TextField fx:id="password" layoutX="50.0" layoutY="274.0" prefHeight="39.0" prefWidth="506.0" promptText="password" style="-fx-background-radius: 2em;">
         <font>
            <Font size="20.0" />
         </font>
      </TextField>
      <Button fx:id="login" layoutX="320.0" layoutY="342.0" mnemonicParsing="false" onAction="#log_in" style="-fx-background-radius: 2em;" text="log in ">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="reg" layoutX="203.0" layoutY="342.0" mnemonicParsing="false" onAction="#regester" style="-fx-background-radius: 2em;" text="regester">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
